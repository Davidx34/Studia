# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs (genericos)
*.log

# PWA service workers generados (next-pwa)
public/sw.js
public/swe-worker-*.js

# Word lock files y exports temporales
~$*
*.docx

# Briefings exportados (mantener solo .md)
FASE_*_BRIEF.docx

.vercel
.env*

# Salida de npm run clip:prepare (videos convertidos, aun sin subir)
clips-out/
poses-out/

# Conjuntos dorados con material REAL de clases (el repositorio es publico): solo en tu maquina
evals/golden/local/

# Prueba de carga (k6): cuentas de prueba y resultados, solo en tu maquina
loadtest/users.json
loadtest/results/

# Muestra ciega y su clave: contenido real de las clases y la clave rompe la ciega; no se publican
memoria-calidad/auditorias/*-clave.json
memoria-calidad/auditorias/*-muestra-ciega.md

# Bucle con juez externo: lotes (preguntas y revisiones con contenido real de las clases) NO se publican; solo las rondas (numeros) si
memoria-calidad/lotes/
